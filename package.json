{
  "name": "dsh-host-ops",
  "version": "0.2.1",
  "description": "Host-side operations for DSH agents: workspaces, sessions, and governed configuration changes. Tools only — no UI.",
  "license": "MIT",
  "author": "laughinbytes",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "agent",
    "workspace",
    "session",
    "configuration",
    "tools",
    "governance"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/laughinbytes/dsh-host-ops.git"
  },
  "homepage": "https://github.com/laughinbytes/dsh-host-ops#readme",
  "bugs": {
    "url": "https://github.com/laughinbytes/dsh-host-ops/issues"
  },
  "icon": "./icon.svg",
  "type": "module",
  "scripts": {
    "test": "npm run test:host && npm run test:compliance && npm run test:presentation && npm run check:standards",
    "test:compliance": "node scripts/check-plugin-compliance.mjs --root . --strict",
    "test:host": "node scripts/verify-dsh-host-ops.mjs && node scripts/verify-dsh-host-ops-schema.mjs",
    "test:presentation": "node scripts/verify-presentation.mjs && node scripts/verify-plugin-meta.mjs --root .",
    "check:standards": "node scripts/check-standards.mjs --local",
    "sync:standards": "node scripts/sync-standards.mjs",
    "check:standards:upstream": "node scripts/check-standards.mjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "CHANGELOG.md",
    "icon.svg",
    "locale/*.json",
    "lib/index.js",
    "cordis.patch.yml",
    "docs/detail.md",
    "docs/detail.zh.md",
    "docs/detail-hero.svg"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.2 || >=0.2.2-rc.1",
    "@deepseek-ai/dsh-workspace": ">=0.2.1-rc.2 || >=0.2.2-rc.1",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-workspace": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.1-rc.2 || >=0.2.2-rc.1"
  }
}
